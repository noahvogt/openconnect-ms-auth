{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "prHourlyLimit": 0,
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a `# renovate:` comment in the Dockerfile",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ENV \\w+='(?<currentValue>[^']+)'"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Update python dependencies in uv.lock only, leaving the >= ranges in pyproject.toml as they are",
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Nothing updated here ships in the AUR package (the PKGBUILD builds the tag against Arch's python packages), so CI decides",
      "matchPackageNames": ["*"],
      "automerge": true
    },
    {
      "description": "uv_build is a makedepends of the AUR package",
      "matchDepTypes": ["build-system.requires"],
      "automerge": false
    }
  ],
  "reviewers": ["noahvogt"]
}
